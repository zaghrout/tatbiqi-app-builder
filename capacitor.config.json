{
  "appId": "sa.tatbiqi.app",
  "appName": "Tatbiqi App",
  "webDir": "src",
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0F766E",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "android": {
        "backgroundColor": "#0F766E"
      }
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F766E"
    }
  }
}
